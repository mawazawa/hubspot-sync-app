# HubSpot Configuration
# Option 1: Private App Access Token (Recommended for server-to-server)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_access_token

# Option 2: OAuth App Configuration (For user-facing apps)
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_REDIRECT_URI=http://localhost:3000/auth/hubspot/callback
HUBSPOT_SCOPES=crm.objects.contacts.read,crm.objects.contacts.write,crm.objects.companies.read,crm.objects.companies.write,crm.objects.deals.read,crm.objects.deals.write

# Google Sheets Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Microsoft Excel Configuration (Optional)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Application Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration (for storing sync configurations)
DATABASE_URL=postgresql://user:password@localhost:5432/hubspot_sync

# Redis Configuration (for caching and job queues)
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your_super_secret_jwt_key
SESSION_SECRET=your_session_secret_key

# Sync Configuration
DEFAULT_SYNC_INTERVAL=300000 # 5 minutes in milliseconds
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5000 # 5 seconds

# Logging
LOG_LEVEL=debug # debug, info, warn, error
LOG_FILE_PATH=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_BULK_OPERATIONS=true
ENABLE_CUSTOM_OBJECTS=true
ENABLE_WEBHOOK_SYNC=false